Bootstrap: docker
From: python:3.12-alpine

%post
    set -eux

    apk add --no-cache ca-certificates curl
    update-ca-certificates

    python -m pip install --no-cache-dir --disable-pip-version-check \
        "huggingface_hub"

    mkdir -p /workspace /workspace/.hf-cache /workspace/.hf-cache/hub

    rm -rf /root/.cache

%environment
    export PYTHONUNBUFFERED=1
    export DO_NOT_TRACK=${DO_NOT_TRACK:-1}

    export HF_HOME=${HF_HOME:-/workspace/.hf-cache}
    export HF_HUB_CACHE=${HF_HUB_CACHE:-/workspace/.hf-cache/hub}
    export HF_HUB_DISABLE_TELEMETRY=${HF_HUB_DISABLE_TELEMETRY:-1}
    export HF_ENDPOINT=${HF_ENDPOINT:-https://bart.sec.samsung.net/artifactory/api/huggingfaceml/huggingface-remote}
    export HF_HUB_ETAG_TIMEOUT=${HF_HUB_ETAG_TIMEOUT:-86400}
    export HF_HUB_DOWNLOAD_TIMEOUT=${HF_HUB_DOWNLOAD_TIMEOUT:-86400}

%runscript
    if [ "$#" -eq 0 ]; then
        exec /bin/sh
    fi

    exec "$@"

%test
    set -eux
    python -c "import sys; print(sys.version); assert sys.version_info[:2] == (3, 12)"
    python -c "import huggingface_hub; print(huggingface_hub.__version__)"
    curl --version
    command -v hf
