Bootstrap: docker
From: nvidia/cuda:13.1.2-cudnn-devel-ubuntu24.04

%files
    SRK_Root_Cert.crt /usr/local/share/ca-certificates/SRK_Root_Cert.crt

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    export CPU_ARCH=x86_64
    export CUDA_REPO_DISTRO=ubuntu2404

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        openssh-client \
        wget \
        python3 \
        python3-dev \
        python3-pip
    update-ca-certificates
    wget "https://developer.download.nvidia.com/compute/cuda/repos/${CUDA_REPO_DISTRO}/${CPU_ARCH}/cuda-keyring_1.1-1_all.deb"
    dpkg -i cuda-keyring_1.1-1_all.deb
    rm -f cuda-keyring_1.1-1_all.deb
    printf '%s\n' \
        'Acquire::https::developer.download.nvidia.com::Verify-Peer "false";' \
        'Acquire::https::developer.download.nvidia.com::Verify-Host "false";' \
        > /etc/apt/apt.conf.d/99nvidia-no-verify-peer
    apt-get update
    apt-get install -y --no-install-recommends \
        "libnccl-dev=2.29.3-1+cuda13.1" \
        "libnccl2=2.29.3-1+cuda13.1"
    rm -rf /var/lib/apt/lists/*

    python3 -m pip install --break-system-packages --no-cache-dir --ignore-installed uv
    export VLLM_VERSION=0.22.1

    uv pip install --system \
        "https://github.com/vllm-project/vllm/releases/download/v${VLLM_VERSION}/vllm-${VLLM_VERSION}-cp38-abi3-manylinux_2_28_${CPU_ARCH}.whl" \
        --extra-index-url "https://download.pytorch.org/whl/cu130"
    python3 -m pip uninstall -y --break-system-packages uv
    python3 -m pip install --break-system-packages --no-cache-dir \
        "qwen-vl-utils"

    mkdir -p /workspace /workspace/.hf-cache /workspace/.hf-cache/hub /outputs /root/.ssh
    chmod 700 /root/.ssh

%environment
    export PYTHONUNBUFFERED=1
    export DO_NOT_TRACK=${DO_NOT_TRACK:-1}

    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

    export CUDA_SCALE_LAUNCH_QUEUES=${CUDA_SCALE_LAUNCH_QUEUES:-2x}

    export HF_HOME=${HF_HOME:-/workspace/.hf-cache}
    export HF_HUB_CACHE=${HF_HUB_CACHE:-/workspace/.hf-cache/hub}
    export HF_HUB_DISABLE_TELEMETRY=${HF_HUB_DISABLE_TELEMETRY:-1}
    export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}

    export VLLM_CACHE_ROOT=${VLLM_CACHE_ROOT:-/dev/shm/vllm-cache}
    export VLLM_NO_USAGE_STATS=${VLLM_NO_USAGE_STATS:-1}
    export VLLM_RPC_BASE_PATH=${VLLM_RPC_BASE_PATH:-/dev/shm/vllm-rpc}
    export VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=${VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS:-1}

%runscript
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi

    exec "$@"

%test
    set -eux
    /usr/bin/python3 -c "import sys; print(sys.version); assert sys.version_info[:2] == (3, 12)"
    ssh -V
    dpkg -s libnccl2 libnccl-dev >/dev/null
    test -f /usr/include/nccl.h
    /usr/bin/python3 -c "import torch; import vllm; print(torch.__version__); print(vllm.__version__); print(torch.version.cuda); assert str(torch.version.cuda).startswith('13.')"
    VLLM_EXT_SO="$(/usr/bin/python3 -c 'import pathlib, vllm._C as ext; print(pathlib.Path(ext.__file__).resolve())')"
    ldd "$VLLM_EXT_SO" | tee /dev/stderr
    ldd "$VLLM_EXT_SO" | grep -F "libcudart.so.13"
    ! ldd "$VLLM_EXT_SO" | grep -F "libcudart.so.12"
