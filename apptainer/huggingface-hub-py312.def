Bootstrap: docker
From: ubuntu:24.04

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
        python3-pip
    update-ca-certificates

    python3 -m pip install --break-system-packages --no-cache-dir --ignore-installed \
        "huggingface_hub"

    apt-get purge -y python3-pip
    apt-get autoremove -y --purge
    apt-get clean
    mkdir -p /workspace /workspace/.hf-cache /workspace/.hf-cache/hub

    rm -rf /var/lib/apt/lists/* /root/.cache

%environment
    export PYTHONUNBUFFERED=1
    export DO_NOT_TRACK=${DO_NOT_TRACK:-1}

    export HF_HOME=${HF_HOME:-/workspace/.hf-cache}
    export HF_HUB_CACHE=${HF_HUB_CACHE:-/workspace/.hf-cache/hub}
    export HF_HUB_DISABLE_TELEMETRY=${HF_HUB_DISABLE_TELEMETRY:-1}
    export HF_ENDPOINT=${HF_ENDPOINT:-https://bart.sec.samsung.net/artifactory/api/huggingfaceml/huggingface-remote}
    export HF_HUB_ETAG_TIMEOUT=${HF_HUB_ETAG_TIMEOUT:-86400}
    export HF_HUB_DOWNLOAD_TIMEOUT=${HF_HUB_DOWNLOAD_TIMEOUT:-86400}

%runscript
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi

    exec "$@"

%test
    set -eux
    /usr/bin/python3 -c "import sys; print(sys.version); assert sys.version_info[:2] == (3, 12)"
    /usr/bin/python3 -c "import huggingface_hub; print(huggingface_hub.__version__)"
    curl --version
    command -v hf
